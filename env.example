# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Provider Configuration
# Set to 'openai' or 'gemini'. If not set, auto-detects based on available API keys.
# OpenAI is preferred if OPENAI_API_KEY is set.
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: specify model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Gemini via Cloudflare Worker Proxy (for Replicate API access from blocked regions)
# Only needed if using AI_PROVIDER=gemini
CLOUDFLARE_WORKER_URL=https://your-worker-name.your-subdomain.workers.dev
CLOUDFLARE_WORKER_SECRET=your_random_secret_key_here

