# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key — нужен для RAG (серверный доступ к law_articles)
# Получить: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider Configuration
# Основная нейросеть для анализа исков — Gemini. OpenAI — опциональная альтернатива.
# Set to 'gemini' or 'openai'. If not set, auto-detects: Gemini if CLOUDFLARE_WORKER_* set, else OpenAI.
AI_PROVIDER=gemini

# Gemini (основная) — через Cloudflare Worker Proxy (Replicate API)
CLOUDFLARE_WORKER_URL=https://your-worker-name.your-subdomain.workers.dev
CLOUDFLARE_WORKER_SECRET=your_random_secret_key_here

# OpenAI (опционально) — альтернативный провайдер
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Feature flags
# Включает RAG-подмешивание образцов возражений (objection_templates) в промпт генерации.
# По умолчанию ВЫКЛ. Включай только в dev/staging до тех пор, пока не выкатили фичу в прод.
OBJECTION_TEMPLATES_ENABLED=false

